rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Private account details. Users can read/write only their own record;
    // admins can read records for account support. Never store passwords here.
    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email','phone','name','createdAt','lastSeen'])
        && request.resource.data.name is string;
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','lastSeen','email','phone']);
      allow delete: if false;
    }

    // Public, intentionally limited profile fields.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name','age','city','bio','photo','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.age is int
        && request.resource.data.age >= 18 && request.resource.data.age <= 100
        && request.resource.data.bio.size() <= 500;
      allow delete: if isOwner(uid);
    }

    // A user may start a private conversation with another authenticated user.
    match /rooms/{roomId} {
      function member() { return signedIn() && resource.data.participants is list && request.auth.uid in resource.data.participants; }
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map;
      allow read: if member();
      allow update: if member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']);
      allow delete: if false;
      match /messages/{messageId} {
        function roomMember() {
          return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId))
            && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
        }
        allow read: if roomMember();
        allow create: if roomMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Admin authorization must be provisioned manually from the Firebase console.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow write: if false;
    }
  }
}
