rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validProfile(data) {
      return data.keys().hasOnly(['name','age','city','photo','bio','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.age is int && data.age >= 18 && data.age <= 100
        && data.city is string && data.city.size() <= 80
        && data.photo is string && data.photo.size() <= 1000
        && data.bio is string && data.bio.size() <= 500;
    }

    // Private account metadata. Passwords are handled only by Firebase Auth.
    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['name','email','phone','createdAt','lastSeen'])
        && request.resource.data.name is string
        && request.resource.data.lastSeen == request.time;
      allow read: if owner(uid) || admin();
      allow list: if admin();
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','phone','lastSeen'])
        && request.resource.data.lastSeen == request.time;
      allow delete: if false;
    }

    // Public discoverable profiles; only the profile owner can edit.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && validProfile(request.resource.data);
      allow delete: if owner(uid);
    }

    // Likes are private to the sender; reciprocal likes are checked for matches.
    match /likes/{uid}/outgoing/{targetUid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && uid != targetUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && exists(/databases/$(database)/documents/profiles/$(targetUid));
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      function isParticipant() {
        return signedIn() && resource.data.participants is list
          && request.auth.uid in resource.data.participants;
      }
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.participants[0])/outgoing/$(request.resource.data.participants[1]))
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.participants[1])/outgoing/$(request.resource.data.participants[0]));
      allow read: if isParticipant();
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 120;
      allow delete: if false;

      match /messages/{messageId} {
        function member() {
          return signedIn()
            && exists(/databases/$(database)/documents/matches/$(matchId))
            && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        }
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['text','senderId','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Create this document manually in Firebase Console for the trusted admin UID.
    // Client-side writes are never allowed to admin records.
    match /admins/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }
  }
}
